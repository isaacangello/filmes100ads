APP_NAME="Filmes 100 ADS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco de dados local (desenvolvimento)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=filmes100ads
DB_USERNAME=root
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@filmes100ads.local"
MAIL_FROM_NAME="${APP_NAME}"

# TMDB API - Obter em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Deploy — InfinityFree (produção)
FTP_HOST=ftpupload.net
FTP_USERNAME=sua_senha_ftp
FTP_PASSWORD=sua_senha_ftp

DB_PROD_HOST=sql202.infinityfree.com
DB_PROD_NAME=if0_42505744_fda
DB_PROD_USERNAME=if0_42505744
DB_PROD_PASSWORD=sua_senha_db

DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_DATABASE=filmes100ads
DB_LOCAL_USERNAME=sail
DB_LOCAL_PASSWORD=password

DEPLOY_PATH="filmes100ads.free.nf/htdocs"
DEPLOY_KEY=sua_chave_deploy
ADMIN_KEY=sua_chave_admin

# Admin do sistema (criado pelo AdminUserSeeder)
ADMIN_EMAIL=admin@filmes100ads.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=admin123

# Minerador CoinImp - Obter credenciais em https://coinimp.com
MINER_ENABLED=false
MINER_SITE_KEY=
MINER_API_PUBLIC=
MINER_API_PRIVATE=
# Script do minerador: URL CDN ou caminho local relativo a public/
# CDN (recomendado pelo CoinImp):
MINER_SCRIPT_PATH=https://www.hostingcloud.racing/RqH3.js
# Local (baixar scripts do painel CoinImp para public/miner/):
# MINER_SCRIPT_PATH=miner/jiB0.php?f=RqH3.js
