# .htaccess para a raiz do htdocs/ no InfinityFree
# Redireciona todas as requisições para public/ e bloqueia acesso a pastas sensíveis
# Baseado no .htaccess do P4O que funciona no InfinityFree

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Bloquear acesso direto a pastas sensíveis do Laravel (antes do redirect)
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor)/ - [F,L]

    # Bloquear acesso a arquivos ocultos (incluindo .env)
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(composer\.json|composer\.lock|artisan|\.env) - [F,L]

    # Redirecionar tudo para public/ (padrão P4O)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
